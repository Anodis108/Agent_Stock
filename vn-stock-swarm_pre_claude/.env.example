# Redis
REDIS_URL=redis://redis:6379/0

# Seed URL — tự động publish vào đúng stream theo loại agent
# (pre_route.guess_agent_type) dựa trên hình dạng URL.
SEED_URLS=https://cafef.vn/thi-truong-chung-khoan.chn,https://vietstock.vn/chung-khoan.htm

# Lịch sự khi crawl
MAX_REQUESTS_PER_SECOND_PER_DOMAIN=1

# Giới hạn
MAX_CRAWL_DEPTH=3
FETCH_TIMEOUT_SECONDS=10
USER_AGENT=VnStockSwarmBot/0.1 (+https://example.com/bot)

# Membership (heartbeat)
HEARTBEAT_INTERVAL_SECONDS=5
AGENT_TTL_SECONDS=15

# Lưu trữ
RESULTS_PATH=/data/results.jsonl
SINK_DB_PATH=/data/sink.db

# Logging
LOG_LEVEL=INFO

# Domain đã biết trước là bảng giá SPA nặng JS — định tuyến thẳng tới
# RenderAgent. Danh sách domain đã đăng ký, phân tách bằng dấu phẩy, ví dụ:
# RENDER_DOMAINS=iboard.ssi.com.vn
RENDER_DOMAINS=

# StealthAgent: danh sách proxy URL phân tách dấu phẩy (để trống nếu chỉ dựa
# vào giảm tốc độ), và giảm tốc bao nhiêu lần so với agent mặc định.
STEALTH_PROXIES=
STEALTH_PACE_MULTIPLIER=5.0
HANDOFF_BLOCK_THRESHOLD=3

# Ngưỡng độ mới của Query Coordinator (tầng Hierarchical, Sơ đồ 3d)
PRICE_STALENESS_SECONDS=900
NEWS_FRESHNESS_SECONDS=7200
COORDINATOR_POLL_TIMEOUT_SECONDS=12
COORDINATOR_POLL_INTERVAL_SECONDS=0.5

# TTL của 1 yêu cầu đang chờ HITL (DBAgent) trong bộ nhớ tiến trình — hết hạn
# thì bị dọn, người dùng phải hỏi lại từ đầu.
PENDING_APPROVAL_TTL_SECONDS=600
