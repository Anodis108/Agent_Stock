FROM mcr.microsoft.com/playwright/python:v1.48.0-jammy

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt .
# Chromium + dependency cấp hệ điều hành đã có sẵn trong base image này, nên
# không cần bước `playwright install` riêng nữa.
RUN pip install -r requirements.txt

COPY src/ src/

RUN mkdir -p /data
# User mặc định của base image Playwright đã có sẵn browser cache trong thư
# mục home của nó; giữ nguyên root ở đây thay vì tranh giành quyền sở hữu —
# chấp nhận được cho 1 worker render đơn nhiệm trong project học tập.

ENTRYPOINT ["python", "-m", "vn_stock_swarm.main"]
