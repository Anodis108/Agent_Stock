# ==============================================================================
# Environment Secrets & Credentials Template — VN Stock Swarm
# ==============================================================================
# HƯỚNG DẪN:
# Sao chép tệp này thành .env và điền các API Key của bạn:
#   cp .env.example .env
#
# LƯU Ý:
# Settings của cả 3 khối (common / web_backend / ai_backend) CHỈ đọc biến môi trường,
# mặc định mọi trường là None — thiếu biến nào thì giá trị đó là None.
# Docker Compose nạp file này (env_file) rồi ghi đè các địa chỉ nội bộ (postgres, minio, qdrant, redis).
# ==============================================================================

# 1. OpenAI API Keys (hỗ trợ phân tách bằng dấu phẩy để dùng Rotating Key Pool)
OPENAI_API_KEYS=sk-proj-xxxxxxxxxxxxxxxxxxxx

# 2. Langfuse Observability Credentials (tùy chọn)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# 3. Qdrant Vector Database Credentials (tùy chọn)
QDRANT_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=portfolio_watch_memory

# 4. Vector Embedding Model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 5. Monitoring & Memory Runtime Flags
MONITORING_ENABLED=true
MEMORY_SHORT_TERM_WINDOW=20
MEMORY_SHORT_TERM_TTL_MINUTES=60

# 6. MinIO — ảnh biểu đồ (access key / secret).
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 6b. PostgreSQL — chuỗi kết nối (có mật khẩu).
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio_watch

# 6c. Redis (REDIS_PORT: cổng host map ra ngoài trong docker-compose)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# 7. Service & Network Configuration
APP_HOST_PORT=8088
# inprocess: swarm chạy trong process web.
# http: web gọi AI_BASE_URL cho /v1/chat, /v1/scan và SSE /v1/chat/stream-sse.
AI_TRANSPORT=inprocess
# AI_HTTP_STREAM_TIMEOUT=300

# 8. Docker Compose Profiles
# Để trống để chỉ chạy cụm Core (web, ai, redis, frontend).
# Đặt "full" để tự động bật cả Postgres, MinIO và Qdrant Vector DB.
COMPOSE_PROFILES=full

# ==============================================================================
# Cấu hình ứng dụng (chuyển từ resources/configs/config.yaml — settings CHỈ đọc biến môi trường)
# ==============================================================================

# App & Server (Web Backend :8000 / AI Backend :8001)
APP_NAME=Portfolio Watch & Chat Agent
WEB_APP_NAME=VN Stock Swarm Web Gateway
WEB_VERSION=1.0.0
AI_APP_NAME=VN Stock Swarm AI Microservice
AI_VERSION=1.0.0
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
AI_HOST=127.0.0.1
AI_PORT=8001
AI_API_HOST=127.0.0.1
AI_API_PORT=8001
CORS_ORIGINS=["*"]
FRONTEND_ORIGIN=http://127.0.0.1:5173
BACKEND_BASE_URL=http://127.0.0.1:8000
AI_BASE_URL=http://127.0.0.1:8001
AI_HTTP_TIMEOUT=60

# LLM Engine & Cascading (openai | ollama | vllm)
LLM_BACKEND=openai
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=30
LLM_MAX_COMPLETION_TOKENS=800
LLM_TOP_P=1.0
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=5
LLM_MODEL_CASCADE=
LLM_FALLBACK_BACKENDS=

# Guardrails
INPUT_GUARDRAILS_ENABLED=true
OUTPUT_GUARDRAILS_ENABLED=true

# 2-Tier Cache (memory | redis)
CACHE_BACKEND=memory
CACHE_EXACT_ENABLED=true
CACHE_SEMANTIC_ENABLED=true
CACHE_SEMANTIC_THRESHOLD=0.93
CACHE_TTL_SECONDS=86400
EXACT_CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true

# Storage — biểu đồ (minio | local) & PostgreSQL
CHART_DIR=./resources/data/charts
CHARTS_DIR=./resources/data/charts
CHART_BACKEND=minio
MINIO_ENDPOINT=localhost:9100
MINIO_BUCKET=charts
MINIO_SECURE=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=portfolio_watch
SQLITE_PATH=./resources/data/fallback/portfolio_watch.db
BACKEND_SQLITE_PATH=./resources/data/fallback/backend_store.db
CONCEPT_COLLECTION=stock_concepts

# Qdrant (host/port dùng khi không có QDRANT_URL)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Market data & Watchlist
PRICE_SOURCE=vnstock
NEWS_SOURCE=cafef
PRICE_FALLBACK_ON_ERROR=false
DEFAULT_WATCHLIST=FPT,VNM,HPG
DEFAULT_ALERT_THRESHOLD_PCT=3.0
SCAN_INTERVAL_MINUTES=60

# Eval & Token Economics
GOLDEN_DATASET_PATH=./resources/eval/golden_dataset.yaml
REPLAY_FAQ_PATH=./resources/eval/replay_faq.yaml
EVAL_CACHE_ENABLED=true
EVAL_CACHE_DIR=.eval_cache
COST_DAILY_LIMIT_USD=0.0
COST_ALERT_THRESHOLD_USD=1.0
CONFIDENCE_AUTO_SEND_MIN=0.8
PROMPT_AB_ENABLED=false
PROMPT_AB_VERSION_A=production
PROMPT_AB_VERSION_B=v2
PROMPT_AB_SPLIT_PCT=50

# Secret Manager (true: đọc bí mật lúc chạy từ GCP Secret Manager)
USE_SECRET_MANAGER=false

# Monitoring (Langfuse)
LANGFUSE_SAMPLE_RATE=1.0
