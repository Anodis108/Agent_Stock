%% Hierarchical Swarm — sinh tự động: python -m ai_backend.infra.graph.run
---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	top_supervisor(top_supervisor)
	chat_supervisor(chat_supervisor)
	scan_supervisor(scan_supervisor)
	price_agent(price_agent)
	news_agent(news_agent)
	eval_agent(eval_agent)
	draw_agent(draw_agent)
	portfolio_watch_agent(portfolio_watch_agent)
	guardrail_input(guardrail_input)
	rewrite_question(rewrite_question)
	concept_retrieval(concept_retrieval)
	answer(answer)
	guardrail_output(guardrail_output)
	event_classifier(event_classifier)
	hitl_gate_2(hitl_gate_2)
	synthesis_agent(synthesis_agent)
	hitl_gate_1(hitl_gate_1)
	__end__([<p>__end__</p>]):::last
	__start__ --> top_supervisor;
	answer --> guardrail_output;
	chat_supervisor -.-> answer;
	chat_supervisor -.-> concept_retrieval;
	chat_supervisor -.-> draw_agent;
	chat_supervisor -.-> eval_agent;
	chat_supervisor -.-> portfolio_watch_agent;
	chat_supervisor -.-> scan_supervisor;
	concept_retrieval --> answer;
	draw_agent --> chat_supervisor;
	eval_agent -.-> chat_supervisor;
	eval_agent -.-> scan_supervisor;
	event_classifier --> scan_supervisor;
	guardrail_input -.-> answer;
	guardrail_input -.-> rewrite_question;
	guardrail_output -.-> __end__;
	guardrail_output -.-> answer;
	hitl_gate_1 --> scan_supervisor;
	hitl_gate_2 --> scan_supervisor;
	news_agent --> scan_supervisor;
	portfolio_watch_agent --> chat_supervisor;
	price_agent --> scan_supervisor;
	rewrite_question --> chat_supervisor;
	scan_supervisor -.-> __end__;
	scan_supervisor -.-> chat_supervisor;
	scan_supervisor -.-> eval_agent;
	scan_supervisor -.-> event_classifier;
	scan_supervisor -.-> hitl_gate_1;
	scan_supervisor -.-> hitl_gate_2;
	scan_supervisor -.-> news_agent;
	scan_supervisor -.-> price_agent;
	scan_supervisor -.-> synthesis_agent;
	synthesis_agent --> scan_supervisor;
	top_supervisor -.-> guardrail_input;
	top_supervisor -.-> scan_supervisor;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
