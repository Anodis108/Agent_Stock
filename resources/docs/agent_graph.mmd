%% Portfolio Watch — agent graph (dễ đọc)
%% Hai nhánh tách riêng; khớp graph/scan.py + graph/chat.py
%% Xem bản HTML: docs/agent_graph.html
flowchart TB
  subgraph SCAN["Nhánh SCAN — giám sát watchlist"]
    direction TB
    S0([START scan]) --> orch[orchestrator]
    orch --> price_s[price_agent]
    orch --> news_s[news_agent]
    price_s --> clf[event_classifier]
    news_s --> clf
    clf -->|normal| END_N([END])
    clf -->|abnormal| eval_s[eval_agent]
    eval_s -->|gate2 proposal| H2[hitl_gate_2]
    eval_s -->|alert| syn[synthesis_agent]
    H2 --> END_H2([END])
    syn --> grd_s[guardrail_output]
    grd_s -->|retry| syn
    grd_s --> conf[confidence_gate]
    conf -->|auto-send| END_A([END])
    conf -->|cần duyệt| H1[hitl_gate_1]
    H1 --> END_H1([END])
  end

  subgraph CHAT["Nhánh CHAT — hỏi đáp"]
    direction TB
    C0([START chat]) --> rw[rewrite_question]
    rw --> sup[supervisor]
    sup --> price_c[price_agent]
    sup --> news_c[news_agent]
    sup --> eval_c[eval_agent]
    price_c --> ans[answer_composer]
    news_c --> ans
    eval_c --> ans
    ans --> grd_c[guardrail_output]
    grd_c --> END_C([END — trả user + steps])
  end
