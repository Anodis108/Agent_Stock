# ─── LLM backend ─────────────────────────────────────────────────────────────
# openai = OpenAI Cloud | ollama = Ollama local | vllm = vLLM server
LLM_BACKEND=openai
# Override base_url (để trống = dùng mặc định của backend):
#   ollama → http://localhost:11434/v1
#   vllm   → http://localhost:8000/v1
LLM_BASE_URL=

# Chỉ cần key thật khi LLM_BACKEND=openai. Có thể nhiều key, ngăn cách dấu phẩy.
OPENAI_API_KEYS=sk-proj-xxxxx
LLM_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.2
LLM_MAX_COMPLETION_TOKENS=800
LLM_TOP_P=1.0
LLM_MAX_RETRIES=5

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Portfolio Watch & Chat Agent
LOG_LEVEL=INFO
# Local (non-Docker): 127.0.0.1. Docker Compose ghi đè API_HOST=0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8000

# ─── Split deploy (V2 / optional) — 3 process ────────────────────────────────
# AI service — process riêng (chỉ cần khi AI_TRANSPORT=http)
AI_API_HOST=127.0.0.1
AI_API_PORT=8001
# Phase 2 mặc định: inprocess (một uvicorn backend.main = UI+API+LangGraph).
# Đặt http chỉ khi muốn Backend proxy sang AI :8001 (compose V2 / test).
AI_TRANSPORT=inprocess
# Backend gọi AI qua AI_BASE_URL khi AI_TRANSPORT=http.
AI_BASE_URL=http://127.0.0.1:8001
# Timeout HTTP Backend→AI (giây). Hết hạn → 502 «AI timeout».
AI_HTTP_TIMEOUT=60
# FE same-origin khi phục vụ từ backend.main (:8000). Tách :5173 thì dùng URL dưới.
BACKEND_BASE_URL=http://127.0.0.1:8000
# Origin frontend — Backend CORS. Dev gộp app: * ; siết: http://127.0.0.1:5173
FRONTEND_ORIGIN=*

# ─── Docker demo (docker compose) ────────────────────────────────────────────
# Port publish host → container (compose: "${APP_HOST_PORT:-8000}:8000")
APP_HOST_PORT=8000
# Đường dẫn DB *trong container* khi dùng volume `pw_sqlite` → /app/data
# (compose environment ghi đè; giữ dòng dưới làm tài liệu / docker run --env-file)
# SQLITE_PATH=/app/data/portfolio_watch.db
#
# Lưu ý: `docker-compose.yml` dùng env_file: .env — mọi biến trong .env đều
# được inject vào container. Hãy copy từ .env.example này (chỉ biến Portfolio
# Watch), không tái sử dụng .env chung với project khác.

# ─── Watchlist defaults (MVP) ────────────────────────────────────────────────
DEFAULT_WATCHLIST=FPT,VNM,HPG
DEFAULT_ALERT_THRESHOLD_PCT=3.0

# ─── Data sources / storage ──────────────────────────────────────────────────
PRICE_SOURCE=vnstock
NEWS_SOURCE=cafef
# Local: ./data/... — Docker Compose override: /app/data/portfolio_watch.db
SQLITE_PATH=./data/portfolio_watch.db
# Backend product DB (watchlist + approvals) — tách khỏi AI SQLITE_PATH
BACKEND_SQLITE_PATH=./data/backend_store.db

# ─── Cron ────────────────────────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=60

# ─── Confidence gate ─────────────────────────────────────────────────────────
CONFIDENCE_AUTO_SEND_MIN=0.8

# ─── V3 — Memory, freshness, Langfuse, Qdrant (optional) ───

# Memory short-term
# Số lượng tin nhắn tối đa lưu trong sliding window cho hội thoại ngắn hạn.
MEMORY_SHORT_TERM_WINDOW=20
# TTL / độ tươi của hội thoại (phút). Tin nhắn cũ hơn sẽ bị loại khỏi ngữ cảnh chat (freshness).
MEMORY_SHORT_TERM_TTL_MINUTES=60

# Long-term / Qdrant (optional)
# URL Qdrant: để trống = fallback in-memory (không cần server ngoài).
# docker compose --profile qdrant up: http://qdrant:6333 (compose override).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=portfolio_watch_memory
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Langfuse / monitoring (optional)
# Tắt mặc định: chat/scan vẫn OK (tracing no-op).
# Bật: MONITORING_ENABLED=true + đủ PUBLIC/SECRET key; restart process AI.
# Chạy app TRONG Docker (AI container): LANGFUSE_HOST=http://host.docker.internal:3000 (hoặc qua compose override)
# Chạy app NGOÀI Docker (uvicorn local): LANGFUSE_HOST=http://localhost:3000
MONITORING_ENABLED=false
# Public key (bắt đầu bằng pk-lf) — để trống khi chưa dùng monitoring
LANGFUSE_PUBLIC_KEY=
# Secret key (bắt đầu bằng sk-lf) — không commit key thật; chỉ điền trong .env local
LANGFUSE_SECRET_KEY=
# Cloud EU mặc định. Self-host ví dụ: http://localhost:3000, US cloud: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
